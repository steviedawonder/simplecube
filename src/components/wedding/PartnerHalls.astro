---
import db from '@lib/db';
import { DEFAULT_PARTNER_HALLS } from '@data/partnerHalls';

// 관리자(/admin/partners)에서 추가·삭제·수정한 목록을 노출.
// DB 조회 자체가 실패했을 때(테이블 미생성·일시 오류)만 기본 목록으로 대체한다.
interface Partner { name: string; image: string; logo?: string }
let partners: Partner[] = DEFAULT_PARTNER_HALLS;
try {
  const result = await db.execute('SELECT name, image_url, logo_url FROM partner_halls WHERE visible = 1 ORDER BY sort_order ASC, id ASC');
  partners = (result.rows as any[]).map((r) => ({ name: r.name, image: r.image_url, logo: r.logo_url || '' }));
} catch { /* fallback */ }
const thumb = (u: string) => (u.includes('res.cloudinary.com') && u.includes('/upload/') ? u.replace('/upload/', '/upload/w_500,h_500,c_fill,f_auto,q_auto/') : u);
const logoThumb = (u: string) => (u.includes('res.cloudinary.com') && u.includes('/upload/') ? u.replace('/upload/', '/upload/w_300,f_auto,q_auto/') : u);
---

{partners.length > 0 && (
<section id="partner-halls" class="bg-white py-10 lg:py-14">
  <div class="mx-auto max-w-7xl px-6 lg:px-8">
    <!-- Header -->
    <div class="gs-fade-up mb-8 lg:mb-10">
      <div class="inline-flex items-center justify-center w-9 h-9 rounded-full border-[1.5px] border-olive text-olive text-[13px] font-bold mb-4">05</div>
      <span class="block text-[11px] font-semibold tracking-[0.5em] text-olive uppercase">Partners</span>
      <h2 class="mt-5 text-[clamp(1.75rem,3vw,2.8rem)] font-bold leading-tight text-primary">제휴 웨딩홀</h2>
      <p class="mt-4 text-sm text-secondary">심플큐브와 제휴된 웨딩홀에서 더욱 특별한 서비스를 만나보세요.</p>
    </div>

    <!-- Partner Grid - name always visible on mobile -->
    <div class="gs-stagger grid grid-cols-5 gap-1.5 md:gap-2 lg:grid-cols-6 lg:gap-3">
      {partners.map((partner) => (
        <div class="group overflow-hidden rounded-xl">
          <div class="relative">
            <img
              src={thumb(partner.image)}
              alt={partner.name}
              class="aspect-square w-full object-cover transition-transform duration-500 group-hover:scale-105"
              loading="lazy"
            />
            {partner.logo && (
              <div class="absolute inset-0 m-auto flex h-[55%] w-[55%] items-center justify-center bg-white/70 p-1.5 md:p-2">
                <img src={logoThumb(partner.logo)} alt="" class="max-h-full max-w-full object-contain" loading="lazy" />
              </div>
            )}
            {/* Desktop: hover overlay */}
            <div class="hidden md:block absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            <div class="hidden md:block absolute bottom-0 left-0 right-0 p-3 translate-y-2 opacity-0 transition-all duration-300 group-hover:translate-y-0 group-hover:opacity-100">
              <p class="text-sm font-semibold text-white">{partner.name}</p>
            </div>
          </div>
          {/* Mobile: name below image */}
          <p class="md:hidden text-[9px] font-medium text-primary text-center py-1 leading-tight">{partner.name}</p>
        </div>
      ))}
    </div>
  </div>
</section>
)}
