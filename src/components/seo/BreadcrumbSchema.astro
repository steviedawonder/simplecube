---
import { ORG_NAME, absUrl } from '@data/business';

interface BreadcrumbItem {
  name: string;
  url: string;
}

interface Props {
  items: BreadcrumbItem[];
  // false: 구조화 데이터만 출력 (자체 히어로가 있어 화면 경로 표시를 두지 않던 페이지 — 브랜드·문의·블로그 목록)
  visible?: boolean;
}

const { items, visible = true } = Astro.props;

// 첫 항목은 '홈' 대신 사이트 이름 — 네이버 가이드: "top"·"홈" 같은 일반 단어 대신 페이지를 설명하는 텍스트
const breadcrumbItems = [
  { name: ORG_NAME, url: absUrl('/') },
  ...items.map(item => ({
    name: item.name,
    url: absUrl(item.url),
  })),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${breadcrumbItems[breadcrumbItems.length - 1].url}#breadcrumb`,
  itemListElement: breadcrumbItems.map((item, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: item.name,
    item: item.url,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

{visible && (
<nav aria-label="Breadcrumb" class="mx-auto max-w-7xl px-6 lg:px-8 pt-24 pb-2">
  <ol class="flex items-center gap-1.5 text-xs text-secondary/60">
    {breadcrumbItems.map((item, index) => (
      <li class="flex items-center gap-1.5">
        {index > 0 && (
          <svg class="w-3 h-3 text-secondary/30 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        )}
        {index === breadcrumbItems.length - 1 ? (
          <span class="text-primary font-medium">{item.name}</span>
        ) : (
          <a href={item.url} class="hover:text-olive transition-colors">{item.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>
)}
