---
// 홈페이지용 Organization + 본사 LocalBusiness + WebSite 스키마.
// 지점(부산·대전·전주)은 네이버 플레이스에 등록돼 있지만 사이트·플레이스·카카오맵 간 주소·전화 표기가
// 아직 통일되지 않아 상세 주소는 넣지 않았다. 표기 통일 후 지점별 LocalBusiness 를 추가할 것.

const siteUrl = 'https://simplecube.net';

// 공식 채널 (존재 확인된 것만)
const SAME_AS = [
  'https://www.instagram.com/simplecube_photobooth',
  'https://www.instagram.com/simplecube_wedding',
  'https://pf.kakao.com/_vxhEfj',
  'https://blog.naver.com/simple_cube',
  'https://m.place.naver.com/place/1454645046',
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#org`,
      name: '심플큐브',
      alternateName: ['SIMPLE CUBE', '심플큐브 포토부스', 'SIMPLE CUBE Photo Booth'],
      url: siteUrl,
      logo: { '@type': 'ImageObject', url: `${siteUrl}/images/common/logo.png`, width: 512, height: 512 },
      description: '2019년 설립된 한국의 1세대 오픈형 포토부스 브랜드. 16,000건 이상의 행사 운영 경력을 바탕으로 웨딩·팝업스토어·기업행사·페스티벌에 맞춤 포토부스 대여 서비스를 제공합니다.',
      foundingDate: '2019',
      sameAs: SAME_AS,
      contactPoint: [
        {
          '@type': 'ContactPoint',
          telephone: '+82-2-338-9180',
          contactType: 'reservations',
          areaServed: 'KR',
          availableLanguage: ['Korean', 'English'],
        },
      ],
      knowsAbout: [
        '포토부스 대여',
        '웨딩 포토부스',
        '결혼식 포토부스',
        '팝업 포토부스',
        '기업행사 포토부스',
        '브랜드 팝업스토어 포토부스',
        '페스티벌 포토부스',
        '포토부스 렌탈',
      ],
      areaServed: [
        { '@type': 'Country', name: '대한민국' },
      ],
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${siteUrl}/#hq`,
      name: '심플큐브',
      alternateName: 'SIMPLE CUBE',
      url: siteUrl,
      telephone: '+82-2-338-9180',
      address: {
        '@type': 'PostalAddress',
        addressLocality: '서울',
        addressRegion: 'Seoul',
        addressCountry: 'KR',
      },
      sameAs: SAME_AS,
      areaServed: [
        { '@type': 'Country', name: '대한민국' },
      ],
      priceRange: '₩₩',
      openingHours: 'Mo-Fr 10:00-18:00',
      parentOrganization: { '@id': `${siteUrl}/#org` },
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: '심플큐브',
      alternateName: 'SIMPLE CUBE',
      url: `${siteUrl}/`,
      inLanguage: 'ko-KR',
      publisher: { '@id': `${siteUrl}/#org` },
    },
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
