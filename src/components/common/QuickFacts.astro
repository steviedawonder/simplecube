---
// '한눈에 보기' — 무엇·얼마·포함·지역·예약을 평문 HTML 로 요약한다.
// 검색 스니펫과 AI 답변(구글 AI 개요·네이버 AI 브리핑·ChatGPT·Perplexity)이 그대로 인용하는 블록이라
// 이미지·스크립트·숨김 처리 없이 텍스트로 두고, 숫자는 /pricing/ 가격 카드·FAQ 와 같은 값만 쓴다.
interface Fact {
  label: string;
  value: string;
}

interface Props {
  summary: string; // 1~2문장, 질문에 바로 답하는 요약
  facts: Fact[];
  asOf?: string; // 정보 기준 — 가격·정책을 바꾸면 함께 갱신
}

const { summary, facts, asOf = '2026년 10월' } = Astro.props;
---

<section aria-labelledby="quick-facts-title" class="bg-white">
  <div class="mx-auto max-w-7xl px-6 lg:px-8 py-6 lg:py-8">
    <h2 id="quick-facts-title" class="text-[11px] font-semibold tracking-[0.3em] text-olive uppercase">한눈에 보기</h2>
    <p class="mt-3 max-w-4xl text-[15px] leading-relaxed text-primary lg:text-base">{summary}</p>
    <dl class="mt-4 grid gap-x-10 text-sm sm:grid-cols-2">
      {facts.map((f) => (
        <div class="flex gap-4 border-b border-border-light py-2.5">
          <dt class="w-14 shrink-0 font-semibold text-primary">{f.label}</dt>
          <dd class="leading-relaxed text-secondary">{f.value}</dd>
        </div>
      ))}
    </dl>
    <p class="mt-3 text-[11px] text-secondary/60">{asOf} 기준 · 정확한 금액은 행사 날짜와 장소를 확인한 뒤 견적으로 안내합니다.</p>
  </div>
</section>
