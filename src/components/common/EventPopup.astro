---

<!-- 본문을 가리거나 스크롤을 막지 않는 비차단형 배너 (구글 모바일 인터스티셜 가이드라인 대응) -->
<div id="event-popup-overlay" class="pointer-events-none fixed inset-0 z-[9999] flex items-end justify-start md:items-start md:justify-start p-4 pb-6 md:p-8 md:pt-24 md:pl-8" style="display:none;">
  <div class="pointer-events-auto relative w-[44vw] max-w-[220px] sm:w-full sm:max-w-[340px]">
    <!-- Close button -->
    <button id="event-popup-close" class="absolute -top-10 right-0 text-white text-sm flex items-center gap-1 hover:opacity-80 transition-opacity" aria-label="닫기">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
      닫기
    </button>

    <!-- Popup image with clickable bottom button -->
    <div class="relative rounded-lg overflow-hidden shadow-2xl">
      <img
        src="/images/popup/noui-event.webp"
        alt="SIMPLE CUBE X NOUI 제휴 고객 한정 특별 혜택 이벤트"
        width="680"
        height="1209"
        class="w-full h-auto block"
        decoding="async"
      />
      <!-- Clickable area covering only the brown button at the bottom (~7% of image height) -->
      <a
        href="https://www.noui.co.kr/product/list.html?cate_no=42"
        target="_blank"
        rel="sponsored noopener noreferrer"
        class="absolute bottom-0 left-0 w-full"
        style="height: 7.5%; cursor: pointer;"
        aria-label="쿠폰 받고 누이 컬렉션 보러가기"
      ></a>
    </div>

    <!-- "오늘 하루 보지 않기" -->
    <button id="event-popup-dismiss" class="mt-3 text-white/80 text-sm hover:text-white transition-colors w-full text-center">
      오늘 하루 보지 않기
    </button>
  </div>
</div>

<script>
  const STORAGE_KEY = 'noui-event-popup-dismissed';
  const SHOW_DELAY_MS = 3000;

  function shouldShowPopup(): boolean {
    try {
      const dismissed = localStorage.getItem(STORAGE_KEY);
      if (!dismissed) return true;
      return new Date(dismissed).toDateString() !== new Date().toDateString();
    } catch {
      return true;
    }
  }

  function setPopup(visible: boolean) {
    const overlay = document.getElementById('event-popup-overlay');
    if (overlay) overlay.style.display = visible ? 'flex' : 'none';
  }

  document.addEventListener('DOMContentLoaded', () => {
    // 진입 직후 본문을 가리지 않도록 잠시 뒤에 표시 (스크롤 잠금 없음)
    if (shouldShowPopup()) setTimeout(() => setPopup(true), SHOW_DELAY_MS);

    document.getElementById('event-popup-close')?.addEventListener('click', () => setPopup(false));

    document.getElementById('event-popup-dismiss')?.addEventListener('click', () => {
      try {
        localStorage.setItem(STORAGE_KEY, new Date().toISOString());
      } catch { /* 저장 실패해도 닫기는 동작 */ }
      setPopup(false);
    });
  });
</script>
