---
import BaseLayout from '@layouts/BaseLayout.astro';
import BrandStory from '@components/brand/BrandStory.astro';
import BranchOffices from '@components/brand/BranchOffices.astro';
import BreadcrumbSchema from '@components/seo/BreadcrumbSchema.astro';

---

<BaseLayout
  title="심플큐브 브랜드 소개 | 2019년부터 포토부스 대여 · 전국 4개 지점"
  description="심플큐브(SIMPLE CUBE)는 2019년부터 16,000건 이상의 행사를 운영한 포토부스 대여 브랜드입니다. 서울 본점과 부산·대전·전주 지점이 웨딩·팝업·기업행사 포토부스를 직접 운영합니다. 브랜드 스토리와 지점별 연락처."
  transparentNav={false}
  pageType="AboutPage"
>
  <BreadcrumbSchema items={[{ name: '브랜드소개', url: '/brand/' }]} visible={false} />
  <!-- 좌측 골드 보더 히어로 (투명 배경) -->
  <section class="pt-20 lg:pt-22">
    <div class="mx-auto max-w-7xl px-6 lg:px-8 py-6 border-b border-border-light">
      <div class="flex items-start gap-4">
        <div class="w-[3px] h-12 bg-olive rounded-full shrink-0 mt-0.5"></div>
        <div>
          <div class="flex items-baseline gap-3">
            <h1 class="text-2xl font-bold text-primary">브랜드소개</h1>
            <span class="text-[11px] font-medium tracking-[0.12em] text-secondary/40">BRAND</span>
          </div>
          <p class="text-[12px] text-secondary/50 mt-1">브랜드 스토리 · 전국 지점 안내</p>
        </div>
      </div>
    </div>
  </section>
  <BrandStory />
  <BranchOffices />
</BaseLayout>
