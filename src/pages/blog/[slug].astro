---
export const prerender = false;

import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/common/Button.astro';
import { safeRows } from '@lib/db';
import { sanitizeSlug, isCleanSlug } from '@utils/slug';
import { cdnImage, cdnCrop } from '@utils/image';
import { ORG_NAME, ORG_REF, PRICE_LABELS, absUrl } from '@data/business';

const { slug } = Astro.params;

// 301 redirect: URL에 공백·마침표 등 불량 문자가 있으면 정리된 슬러그로 리다이렉트
if (slug && !isCleanSlug(decodeURIComponent(slug))) {
  const cleanSlug = sanitizeSlug(decodeURIComponent(slug));
  return Astro.redirect(`/blog/${cleanSlug}/`, 301);
}

const decodedSlug = decodeURIComponent(slug ?? '');

const result = await safeRows<any>({
  sql: `SELECT p.*, c.name as category_name, c.slug as category_slug
        FROM posts p LEFT JOIN categories c ON p.category_id = c.id
        WHERE p.slug = ? AND p.deleted_at IS NULL`,
  args: [decodedSlug],
});

// DB 일시 오류: 500 이나 404 대신 503 + 재시도 안내 (검색엔진이 글을 지우지 않고 나중에 다시 온다)
if (!result.ok) {
  return new Response('일시적인 오류입니다. 잠시 후 다시 시도해 주세요.', {
    status: 503,
    headers: { 'Content-Type': 'text/plain; charset=utf-8', 'Retry-After': '120', 'Cache-Control': 'no-store' },
  });
}

// 없는 글·초안은 /blog 로 302 하지 않고 404 (soft 404 방지)
if (result.rows.length === 0) {
  return Astro.rewrite('/404/');
}

const post = result.rows[0];

if (post.external_url) {
  return Astro.redirect(post.external_url);
}

if (post.draft || (post.scheduled_at && new Date(post.scheduled_at) > new Date())) {
  return Astro.rewrite('/404/');
}

// Tags
const tagsResult = await safeRows<{ name: string; slug: string }>({
  sql: 'SELECT t.name, t.slug FROM tags t JOIN post_tags pt ON t.id = pt.tag_id WHERE pt.post_id = ?',
  args: [post.id],
});
const tags = tagsResult.rows.map((t) => t.name);

// Related posts (same category or shared tags, max 3)
const relatedResult = await safeRows<any>({
  sql: `SELECT DISTINCT p.id, p.title, p.slug, p.description, p.image, p.created_at, c.name as category_name
        FROM posts p
        LEFT JOIN categories c ON p.category_id = c.id
        WHERE p.draft = 0 AND p.deleted_at IS NULL AND p.id != ?
          AND (scheduled_at IS NULL OR scheduled_at <= datetime('now'))
          AND (p.external_url IS NULL OR p.external_url = '')
          AND (
            p.category_id = ?
            OR EXISTS (
              SELECT 1 FROM post_tags pt1
              JOIN post_tags pt2 ON pt1.tag_id = pt2.tag_id
              WHERE pt1.post_id = ? AND pt2.post_id = p.id
            )
          )
        ORDER BY p.created_at DESC
        LIMIT 3`,
  args: [post.id, post.category_id || -1, post.id],
});
let relatedPosts = relatedResult.rows;
// 같은 주제 글이 3개 미만이면 최신 글로 채운다 — 모든 글이 다른 글에서 링크되도록 (목록 페이지 외 유입 링크가 없던 글 7편)
if (relatedPosts.length < 3) {
  const latest = await safeRows<any>({
    sql: `SELECT p.id, p.title, p.slug, p.description, p.image, p.created_at, c.name as category_name
          FROM posts p
          LEFT JOIN categories c ON p.category_id = c.id
          WHERE p.draft = 0 AND p.deleted_at IS NULL AND p.id != ?
            AND (p.scheduled_at IS NULL OR p.scheduled_at <= datetime('now'))
            AND (p.external_url IS NULL OR p.external_url = '')
          ORDER BY p.created_at DESC
          LIMIT 6`,
    args: [post.id],
  });
  const seen = new Set(relatedPosts.map((p) => p.id));
  relatedPosts = [...relatedPosts, ...latest.rows.filter((p) => !seen.has(p.id))].slice(0, 3);
}

// ── Utilities ────────────────────────────────────────────────────────────────

function calcReadingTime(html: string): number {
  const text = html.replace(/<[^>]*>/g, '');
  const korean = (text.match(/[\uAC00-\uD7AF]/g) || []).length;
  const english = (text.match(/[a-zA-Z]+/g) || []).length;
  return Math.max(1, Math.ceil((Math.ceil(korean / 2.5) + english) / 200));
}

interface ToCItem { id: string; level: number; text: string }

// 목차 + 제목 id 를 한 번에: 글자 없는 헤딩(네이버 에디터 잔재 <h2><span><b><br></b></span></h2>)은 지우고
// (이미지만 든 헤딩은 문단으로 보존), id 는 실제 글자가 있는 h2·h3 에만 순서대로 붙인다.
// 예전에는 빈 헤딩도 id 순번을 차지해 목차 링크가 엉뚱한 제목으로 이동했다(5편, 49개).
function buildToc(html: string): { html: string; toc: ToCItem[] } {
  const toc: ToCItem[] = [];
  const out = html.replace(/<h([1-6])(\s[^>]*)?>([\s\S]*?)<\/h\1>/gi, (_m, lvl: string, attrs = '', inner: string) => {
    const text = inner.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/[\u200B-\u200D\uFEFF]/g, '').trim();
    if (!text) return /<img\b/i.test(inner) ? `<p>${inner}</p>` : '';
    if (lvl !== '2' && lvl !== '3') return `<h${lvl}${attrs}>${inner}</h${lvl}>`;
    const id = `h-${toc.length}`;
    toc.push({ id, level: Number(lvl), text });
    return `<h${lvl} id="${id}"${attrs.replace(/\sid=(["'])[^"']*\1/i, '')}>${inner}</h${lvl}>`;
  });
  return { html: out, toc };
}

function escapeAttr(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;');
}

// 줄바꿈·제로폭 문자 제거 (meta description, JSON-LD 용)
function cleanText(s: string): string {
  return s.replace(/[\u200B-\u200D\uFEFF]/g, '').replace(/\s+/g, ' ').trim();
}

// 붙여넣기(네이버 에디터 등) 잔재 정리: 빈 헤딩 제거, 본문 h1 → h2(페이지 h1 은 제목 하나),
// 의미 없는 alt 는 글 제목으로, Cloudinary 이미지는 자동 포맷·폭 제한 + 지연 로딩
function normalizeContent(html: string, title: string): string {
  const alt = escapeAttr(title);
  return html
    .replace(/<h([1-6])[^>]*>(?:\s|&nbsp;|<br\s*\/?>)*<\/h\1>/gi, '')
    .replace(/<h1(\s[^>]*)?>/gi, (_m, attrs = '') => `<h2${attrs}>`)
    .replace(/<\/h1>/gi, '</h2>')
    // 본문 속 사이트 링크는 슬래시로 끝나는 정식 주소로 (예: /popup#portfolio → /popup/#portfolio, 301 을 거치지 않게)
    .replace(
      /href=(["'])(?:https?:\/\/(?:www\.)?simplecube\.net)?\/(popup|wedding|rental|corporate|pricing|graduation|brand|contact|seoul|busan|daegu|daejeon|gwangju|ulsan|jeonju|cheonan|cheongju|chungju)(#[^"']*)?\1/gi,
      (_m, q: string, page: string, hash = '') => `href=${q}/${page}/${hash}${q}`
    )
    .replace(/<img\b([^>]*)>/gi, (_m, attrs: string) => {
      let a = attrs.replace(/\s\/$/, '');
      a = a.replace(/\salt=(["'])(?:\s*|붙여넣기 이미지|image|이미지)\1/i, '');
      if (!/\salt=/i.test(a)) a += ` alt="${alt}"`;
      a = a.replace(/\ssrc=(["'])(https:\/\/res\.cloudinary\.com\/[^"']+)\1/i, (_s, q, url) => ` src=${q}${cdnImage(url, 1200)}${q}`);
      if (!/\sloading=/i.test(a)) a += ' loading="lazy"';
      if (!/\sdecoding=/i.test(a)) a += ' decoding="async"';
      return `<img${a}>`;
    });
}

// ── Derived data ─────────────────────────────────────────────────────────────

const content = normalizeContent(String(post.content || ''), String(post.title));
const metaDescription = cleanText(String(post.seo_description || post.description || ''));
const readingTime = calcReadingTime(content);
const { html: processedContent, toc } = buildToc(content);
const hasToc = toc.length >= 3;

// 본문 아래 '관련 서비스' — 글 주제(제목·카테고리·태그)에 맞는 서비스 페이지로 연결.
// 블로그 12편 중 11편이 서비스 페이지로 가는 링크가 0개였다 (방문자·검색엔진 모두 블로그에서 서비스 페이지로 못 감).
const SERVICE_LINKS = [
  { re: /웨딩|결혼|예식|하객|성당|웨딩홀|신랑|신부/, href: '/wedding/', label: '웨딩 포토부스 구성 보기' },
  { re: /기업|컨퍼런스|임직원|사내|송년회|신년회|세미나|박람회/, href: '/corporate/', label: '기업행사 포토부스' },
  { re: /팝업|페스티벌|축제|브랜드|런칭|와인/, href: '/popup/', label: '팝업·행사 포토부스' },
  { re: /졸업|학교|대학|어린이|유치원|학생/, href: '/graduation/', label: '졸업식·학교 행사 포토부스' },
];
const topic = `${post.title} ${post.category_name ?? ''} ${tags.join(' ')}`;
const serviceLinks = SERVICE_LINKS.filter((l) => l.re.test(topic)).slice(0, 2);
if (serviceLinks.length === 0) serviceLinks.push({ re: /./, href: '/rental/', label: '포토부스 대여 안내' });
serviceLinks.push({ re: /./, href: '/pricing/', label: `포토부스 대여 가격 (웨딩 ${PRICE_LABELS.wedding}~ · 행사 ${PRICE_LABELS.event}~)` });
const quoteHref = serviceLinks[0].href === '/wedding/' ? '/contact/' : '/inquiry/popup/';

// canonical 과 같은 퍼센트 인코딩 형태 (JSON-LD @id 가 WebPage 노드와 정확히 일치하도록)
const pageUrl = absUrl(`/blog/${post.slug}/`);
const publishedISO = new Date(post.created_at).toISOString();
const modifiedISO  = new Date(post.updated_at).toISOString();
const wordCount = (content.replace(/<[^>]*>/g, '').match(/\S+/g) || []).length;

// ── JSON-LD ───────────────────────────────────────────────────────────────────

// 대표 이미지: Google 권장 16:9·4:3·1:1 을 Cloudinary 로 정확한 크기로 잘라 실제 크기와 일치시킨다
// (Cloudinary 가 아닌 이미지는 크기를 적지 않고 URL 만)
const articleImages = post.image
  ? ([[1200, 675], [1200, 900], [1200, 1200]] as const)
      .map(([width, height]) => {
        const url = cdnCrop(post.image, width, height);
        return url && { '@type': 'ImageObject', url, width, height };
      })
      .filter(Boolean)
  : [];

const blogPostingLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${pageUrl}#article`,
  url: pageUrl,
  mainEntityOfPage: { '@id': pageUrl },
  inLanguage: 'ko-KR',
  headline: post.title,
  description: metaDescription,
  datePublished: publishedISO,
  dateModified: modifiedISO,
  wordCount,
  keywords: tags.join(', '),
  articleSection: post.category_name || '포토부스',
  ...(post.image && { image: articleImages.length > 0 ? articleImages : [post.image] }),
  author: ORG_REF,
  publisher: ORG_REF,
};

const breadcrumbItems = [
  { '@type': 'ListItem', position: 1, name: ORG_NAME, item: absUrl('/') },
  { '@type': 'ListItem', position: 2, name: '블로그', item: absUrl('/blog/') },
  { '@type': 'ListItem', position: 3, name: post.title, item: pageUrl },
];

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${pageUrl}#breadcrumb`,
  itemListElement: breadcrumbItems,
};

const formattedDate = new Date(post.created_at).toLocaleDateString('ko-KR', {
  year: 'numeric', month: 'long', day: 'numeric',
});
---

<BaseLayout
  title={`${post.seo_title || post.title} | 심플큐브`}
  description={metaDescription}
  ogImage={post.image || undefined}
  ogType="article"
  articleMeta={{
    publishedTime: publishedISO,
    modifiedTime: modifiedISO,
    section: post.category_name || '포토부스',
    tags,
  }}
>
  <script type="application/ld+json" set:html={JSON.stringify(blogPostingLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <article class="pt-28 pb-16 lg:pt-32 lg:pb-24">
    <div class="mx-auto max-w-3xl px-6 lg:px-8">

      <!-- Breadcrumb -->
      <nav aria-label="breadcrumb" class="mb-6 flex items-center gap-1.5 text-xs text-secondary-light">
        <a href="/" class="hover:text-primary transition-colors">심플큐브</a>
        <span aria-hidden="true">/</span>
        <a href="/blog/" class="hover:text-primary transition-colors">블로그</a>
        {post.category_name && (
          <>
            <span aria-hidden="true">/</span>
            <span>{post.category_name}</span>
          </>
        )}
      </nav>

      <!-- Category + Date + Reading time -->
      <div class="flex flex-wrap items-center gap-3">
        {post.category_name && (
          <span class="rounded-full bg-olive-tint px-3 py-1 text-xs font-medium text-olive">
            {post.category_name}
          </span>
        )}
        <time class="text-sm text-secondary-light" datetime={post.created_at}>
          {formattedDate}
        </time>
        <span class="text-sm text-secondary-light">·</span>
        <span class="text-sm text-secondary-light">읽기 {readingTime}분</span>
      </div>

      <!-- Title -->
      <h1 class="mt-4 text-[clamp(1.75rem,3.5vw,2.5rem)] font-bold leading-tight text-primary">
        {post.title}
      </h1>

      <!-- Description -->
      <p class="mt-4 text-lg text-secondary">{post.description}</p>

      <!-- Featured image -->
      {post.image && (
        <div class="mt-8 overflow-hidden rounded-2xl">
          <img
            src={cdnImage(post.image, 900)}
            srcset={`${cdnImage(post.image, 480)} 480w, ${cdnImage(post.image, 900)} 900w, ${cdnImage(post.image, 1200)} 1200w`}
            sizes="(min-width: 768px) 768px, 100vw"
            alt={post.seo_title || post.title}
            class="w-full object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            width="900"
            height="506"
          />
        </div>
      )}

      <!-- Table of Contents -->
      {hasToc && (
        <nav
          aria-label="목차"
          class="my-10 rounded-xl border border-border-light bg-bg-light px-6 py-5"
        >
          <p class="mb-3 text-sm font-semibold text-primary">목차</p>
          <ol class="space-y-1.5">
            {toc.map((item) => (
              <li style={`margin-left: ${(item.level - 2) * 1.25}rem`}>
                <a
                  href={`#${item.id}`}
                  class="text-sm text-secondary hover:text-olive transition-colors"
                >
                  {item.text}
                </a>
              </li>
            ))}
          </ol>
        </nav>
      )}

      <!-- Body content -->
      <div class="blog-content mt-12" set:html={processedContent} />

      <!-- 관련 서비스 (블로그 → 서비스 페이지 내부 링크) -->
      <nav aria-label="관련 서비스" class="mt-12 rounded-xl border border-olive/30 bg-olive-tint p-5 lg:p-6">
        <p class="text-sm font-semibold text-primary">이 글과 관련된 심플큐브 서비스</p>
        <ul class="mt-3 flex flex-wrap gap-2">
          {serviceLinks.map((l) => (
            <li>
              <a href={l.href} class="inline-block rounded-full border border-olive/40 bg-white px-4 py-2 text-sm text-primary transition-colors hover:border-olive">{l.label} →</a>
            </li>
          ))}
        </ul>
        <a href={quoteHref} class="mt-4 inline-block rounded-lg bg-olive px-5 py-2.5 text-sm font-semibold text-white transition-opacity hover:opacity-90">무료 견적 문의</a>
      </nav>

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="mt-12 flex flex-wrap gap-2 border-t border-border-light pt-6">
          {tags.map((tag: string) => (
            <span class="rounded-full bg-bg-light px-3 py-1 text-xs text-secondary">#{tag}</span>
          ))}
        </div>
      )}

      <!-- Author bio (E-E-A-T) -->
      <div class="mt-12 flex items-start gap-4 rounded-xl border border-border-light bg-bg-light p-5">
        <img
          src="/images/common/og-image.jpg"
          alt="심플큐브"
          class="h-14 w-14 flex-shrink-0 rounded-full object-cover"
          width="56"
          height="56"
          loading="lazy"
        />
        <div>
          <p class="text-sm font-semibold text-primary">심플큐브 (SIMPLE CUBE)</p>
          <p class="mt-1 text-xs text-secondary leading-relaxed">
            2019년부터 16,000건 이상의 행사를 운영한 포토부스 대여 브랜드. 서울 본점과 부산·대전·전주 지점에서 웨딩·팝업·기업행사 포토부스를 전국 출장 설치합니다.
          </p>
          <a
            href="/brand/"
            class="mt-2 inline-block text-xs text-olive hover:underline"
            aria-label="심플큐브 브랜드 소개 페이지로 이동"
          >
            브랜드 소개 →
          </a>
        </div>
      </div>

      <!-- Back button -->
      <div class="mt-10">
        <Button href="/blog/" variant="outline" size="sm">← 목록으로 돌아가기</Button>
      </div>
    </div>

    <!-- Related posts -->
    {relatedPosts.length > 0 && (
      <section class="mt-20 border-t border-border-light pt-16">
        <div class="mx-auto max-w-5xl px-6 lg:px-8">
          <h2 class="mb-8 text-xl font-bold text-primary">관련 글</h2>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {relatedPosts.map((rp: any) => (
              <a
                href={`/blog/${rp.slug}/`}
                class="group rounded-2xl border border-border-light bg-white overflow-hidden hover:shadow-md transition-shadow"
              >
                {rp.image && (
                  <div class="aspect-[16/9] overflow-hidden">
                    <img
                      src={rp.image}
                      alt={rp.title}
                      class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                      loading="lazy"
                      width="480"
                      height="270"
                    />
                  </div>
                )}
                <div class="p-4">
                  {rp.category_name && (
                    <span class="text-xs font-medium text-olive">{rp.category_name}</span>
                  )}
                  <p class="mt-1 text-sm font-semibold text-primary line-clamp-2 group-hover:text-olive transition-colors">
                    {rp.title}
                  </p>
                  <p class="mt-1 text-xs text-secondary line-clamp-2">{rp.description}</p>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style is:global>
  .blog-content h1 { font-size: 2rem; font-weight: 700; margin-top: 3rem; margin-bottom: 1rem; color: var(--color-primary); }
  .blog-content h2 { font-size: 1.5rem; font-weight: 700; margin-top: 2.5rem; margin-bottom: 1rem; color: var(--color-primary); }
  .blog-content h3 { font-size: 1.25rem; font-weight: 600; margin-top: 2rem; margin-bottom: 0.75rem; color: var(--color-primary); }
  .blog-content h4 { font-size: 1.1rem; font-weight: 600; margin-top: 1.75rem; margin-bottom: 0.5rem; color: var(--color-primary); }
  .blog-content p { margin-bottom: 1.25rem; line-height: 1.8; color: var(--color-secondary); }
  .blog-content ul, .blog-content ol { margin-bottom: 1.25rem; padding-left: 1.5rem; color: var(--color-secondary); }
  .blog-content li { margin-bottom: 0.5rem; line-height: 1.8; }
  .blog-content strong { color: var(--color-primary); font-weight: 600; }
  .blog-content hr { margin: 2rem 0; border-color: var(--color-border-light); }
  .blog-content a { color: var(--color-olive); text-decoration: underline; }
  .blog-content blockquote { border-left: 3px solid var(--color-olive); padding-left: 1rem; margin: 1.5rem 0; color: var(--color-secondary); font-style: italic; }
  .blog-content img { max-width: 100%; height: auto; border-radius: 0.75rem; margin: 1.5rem 0; }
  .blog-content table { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: 0.9rem; }
  .blog-content th, .blog-content td { border: 1px solid var(--color-border-light); padding: 0.6rem 0.8rem; text-align: left; }
