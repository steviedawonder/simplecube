---
export const prerender = true;
import BaseLayout from '@layouts/BaseLayout.astro';
import HeroSection from '@components/home/HeroSection.astro';
import ServicesSection from '@components/home/ServicesSection.astro';
import WhySimpleCube from '@components/home/WhySimpleCube.astro';
import ClientShowcase from '@components/popup/ClientShowcase.astro';
import BrandStory from '@components/brand/BrandStory.astro';
import OrganizationSchema from '@components/seo/OrganizationSchema.astro';
import EventPopup from '@components/common/EventPopup.astro';
import QuickFacts from '@components/common/QuickFacts.astro';
import { HOURS_LABEL, PRICE_LABELS } from '@data/business';
---

<BaseLayout
  title="심플큐브 | 프리미엄 포토부스 대여 — 웨딩·팝업·기업행사"
  description="2019년부터 16,000건, 프리미엄 포토부스 브랜드 심플큐브. 웨딩·팝업·기업행사 포토부스 대여를 전국 출장 설치합니다. 웨딩 50만원~·행사 55만원~, 무료 견적 상담."
  keywords="심플큐브, 심플큐브 포토부스, SIMPLE CUBE, 포토부스 대여, 포토부스 렌탈, 웨딩 포토부스, 결혼식 포토부스, 팝업 포토부스, 브랜드 팝업스토어 포토부스, 기업행사 포토부스, 페스티벌 포토부스, 행사 포토부스 대여, 전국 포토부스 출장"
  transparentNav={true}
>
  <OrganizationSchema />
  <HeroSection />
  <QuickFacts
    summary="심플큐브(SIMPLE CUBE)는 웨딩·브랜드 팝업·기업행사·졸업식 현장에 포토부스를 설치하고 운영까지 맡는 포토부스 대여 브랜드입니다. 2019년부터 16,000건 이상의 행사를 운영했고, 서울 본점과 부산·대전·전주 지점에서 전국으로 출장합니다."
    facts={[
      { label: '서비스', value: '웨딩 포토부스 · 브랜드 팝업 · 기업행사 · 졸업식·학교 행사 · 페스티벌' },
      { label: '가격', value: `웨딩 ${PRICE_LABELS.wedding}~ (최대 할인가 ${PRICE_LABELS.weddingMaxDiscount}) · 행사 ${PRICE_LABELS.event}~` },
      { label: '포함', value: '맞춤 프레임 디자인 · 무제한 즉석 인화(장당 약 15초) · 설치·철거 · 디지털 파일 제공' },
      { label: '지역', value: '전국 출장 · 서울 본점과 부산·대전·전주 지점이 직접 운영' },
      { label: '예약', value: '카카오톡 또는 전화(02-338-9180)로 날짜·장소 전달 → 견적 → 디자인 확정 → 당일 설치·운영' },
      { label: '상담', value: HOURS_LABEL },
    ]}
  />
  <ServicesSection />
  <WhySimpleCube />
  <ClientShowcase />
  <BrandStory />
  <!-- 고정 위치 배너라 본문 뒤에 둠 — 검색엔진이 팝업 문구를 페이지 첫 문장으로 읽지 않도록 -->
  <EventPopup />
</BaseLayout>

<script>
  // Scroll-down button → scroll to footer
  const scrollBtn = document.getElementById('scroll-down-btn');
  if (scrollBtn) {
    scrollBtn.addEventListener('click', () => {
      const hero = document.getElementById('hero');
      if (hero && hero.nextElementSibling) {
        hero.nextElementSibling.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }
</script>
