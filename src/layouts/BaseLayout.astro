---
import '../styles/global.css';
import Navbar from '@components/common/Navbar.astro';
import Footer from '@components/common/Footer.astro';
import FloatingContactButton from '@components/common/FloatingContactButton.astro';
import WebPageSchema from '@components/seo/WebPageSchema.astro';


interface ArticleMeta {
  publishedTime: string;
  modifiedTime: string;
  section?: string;
  tags?: string[];
}

interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  ogImage?: string;
  ogType?: string;
  articleMeta?: ArticleMeta;
  transparentNav?: boolean;
  noindex?: boolean;
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
}

const {
  title = '심플큐브 | SIMPLE CUBE',
  description = '특별한 순간을 담는 포토부스, 심플큐브. 팝업 포토부스와 웨딩 포토부스 서비스를 제공합니다.',
  keywords,
  ogImage = '/images/common/og-image.jpg',
  ogType = 'website',
  articleMeta,
  transparentNav = false,
  noindex = false,
  pageType,
} = Astro.props;

// canonical 은 항상 슬래시로 끝나는 형태로 통일 (사이트맵·내부 링크와 동일)
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(canonicalPath, Astro.site);
const ogImageURL = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-5JG6SWNF');</script>
    <!-- End Google Tag Manager -->

    <!-- 문의 경로 클릭 측정 — 카카오톡·전화·인스타그램·문의 버튼 클릭을 사이트가 직접 기록
         (대행사 GTM 의 카카오 트리거는 /contact/ 서울 TALK 버튼 1개에만 걸려 있어 나머지 클릭이 집계되지 않음) -->
    <script is:inline>
      (function () {
        // 지점 구분: 카카오 채널 ID · 전화번호(숫자만) · 인스타그램 계정 → 지점 코드
        var BRANCH = {
          _vxhEfj: 'seoul', _RxgxkPb: 'busan', _xgqgyb: 'daejeon', _TPxjxoG: 'jeonju',
          '023389180': 'seoul', '01031224746': 'busan', '01088388122': 'daejeon', '01057438122': 'jeonju',
          simplecube_photobooth: 'seoul', simplecube_wedding: 'seoul',
          simplecube_busan: 'busan', simplecube_daejeon: 'daejeon', simplecube_jeonju: 'jeonju'
        };
        // GTM 이 설치한 GA4 (측정 ID). 페이지에서 보내는 gtag 이벤트는 send_to 를 지정해야 GA4 로 전송된다
        var GA4_ID = 'G-1ZLPBMQXNH';
        function gtag() { window.dataLayer.push(arguments); }
        function classify(a) {
          var href = a.getAttribute('href') || '';
          if (/^tel:/i.test(href)) return { method: 'phone', branch: BRANCH[href.replace(/\D/g, '')] };
          if (/^mailto:/i.test(href)) return { method: 'email' };
          var u;
          try { u = new URL(href, location.href); } catch (e) { return null; }
          var first = u.pathname.split('/')[1] || '';
          if (u.hostname === 'pf.kakao.com') return { method: 'kakao', branch: BRANCH[first] };
          if (/(^|\.)instagram\.com$/.test(u.hostname)) return { method: 'instagram', branch: BRANCH[first.toLowerCase()] };
          if (u.origin === location.origin && (first === 'contact' || first === 'inquiry')) return { method: 'inquiry_cta' };
          return null;
        }
        // 캡처 단계에서 듣는다 — 다른 스크립트가 클릭 전파를 막아도 기록되고, 이동(새 탭·전화 앱)은 막지 않는다
        document.addEventListener('click', function (e) {
          var a = e.target instanceof Element ? e.target.closest('a[href]') : null;
          var info = a && classify(a);
          if (!info) return;
          var params = {
            method: info.method,
            branch: info.branch || 'none',
            link_url: a.href,
            link_text: (a.textContent || '').replace(/\s+/g, ' ').trim().slice(0, 40) || a.getAttribute('aria-label') || '',
            link_area: a.closest('footer') ? 'footer' : a.closest('#floating-quick') ? 'floating' : a.closest('header') ? 'header' : 'main',
            page_path: location.pathname
          };
          try {
            window.dataLayer = window.dataLayer || [];
            // GTM 트리거용 맞춤 이벤트 — 네이버 광고 전환 등은 GTM 에서 이 이벤트(contact_click)에 연결
            window.dataLayer.push(Object.assign({ event: 'contact_click' }, params));
            // GA4 로 직접 전송 (GTM 이 설치한 Google 태그가 처리) — GTM 에 contact_click 용 GA4 태그를 또 만들면 중복
            gtag('event', 'contact_click', Object.assign({ send_to: GA4_ID }, params));
          } catch (err) { /* 측정 실패가 클릭 동작에 영향 주지 않음 */ }
        }, true);
      })();
    </script>

    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="generator" content={Astro.generator} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    {/* 크기를 아는 기본 이미지일 때만 width/height 를 명시 (다른 이미지에 1200x630 을 잘못 붙이지 않도록) */}
    {ogImage === '/images/common/og-image.jpg' && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:site_name" content="심플큐브" />
    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        <meta property="article:modified_time" content={articleMeta.modifiedTime} />
        {articleMeta.section && <meta property="article:section" content={articleMeta.section} />}
        {articleMeta.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- RSS Feed -->
    <link rel="alternate" type="application/rss+xml" title="심플큐브 블로그" href="/rss.xml" />

    <!-- Search Console Verification -->
    <meta name="google-site-verification" content="eMVHYc4YEOBc4da4f2fG2YCe91nBPYkVXcmei8k9JGc" />
    <meta name="google-site-verification" content="DukaOvIwHQehXec84U2y-rXabY9hmF9ORu9PRuiwMkA" />
    <meta name="naver-site-verification" content="99c64b13d13f52803d63e4045c28cda795b4b236" />
    <meta name="naver-site-verification" content="150bf729f3a990a0df87650a68846e90cf404794" />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- 구조화 데이터: 페이지 노드 (WebSite·회사·이동 경로와 @id 로 연결) -->
    {!noindex && <WebPageSchema url={canonicalURL.href} name={title} description={description} type={pageType} />}


    <!-- 홈 히어로 키워드 전용 Noto Sans KR 900 — 실제 쓰는 글자만 받는 초소형 서브셋.
         홈에서만, media=print → all 로 렌더를 막지 않게 받는다 (다른 페이지에서 FCP 를 4초까지 늦추던 원인) -->
    {Astro.url.pathname === '/' && (
      <>
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@900&display=swap&text=%EC%9B%A8%EB%94%A9%EB%B8%8C%EB%9E%9C%EB%93%9C%EA%B8%B0%EC%97%85%ED%96%89%EC%82%AC%ED%8E%98%EC%8A%A4%ED%8B%B0%EB%B2%8C%EB%AA%A8%EB%93%A0%EC%88%9C%EA%B0%84" rel="stylesheet" media="print" onload="this.media='all'" />
      </>
    )}

    <title>{title}</title>

    <!-- Naver Analytics (비동기 로드 — 렌더링을 막지 않음) -->
    <script is:inline>
      (function () {
        // 대행사 GTM 의 네이버 광고 태그도 같은 전역 wcs_add.wa 를 자기 키(s_…)로 바꾼다.
        // wcs_do() 호출 직전에 우리 키를 다시 넣어야 네이버 애널리틱스 페이지뷰가 대행사 키로 새지 않는다.
        var NA_KEY = '2403ec27630898';
        window.wcs_add = window.wcs_add || {};
        window.wcs_add['wa'] = NA_KEY;
        var s = document.createElement('script');
        s.src = 'https://wcs.pstatic.net/wcslog.js';
        s.async = true;
        s.onload = function () {
          if (!window.wcs) return;
          window.wcs_add['wa'] = NA_KEY;
          window.wcs_do();
        };
        document.head.appendChild(s);
      })();
    </script>
  </head>
  <body class="bg-white text-primary antialiased">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5JG6SWNF"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <Navbar transparent={transparentNav} />

    <main>
      <slot />
    </main>

    <Footer />

    <FloatingContactButton />

    <!-- 스크롤 등장 애니메이션 (.gs-*)
         첫 화면에 보이는 내용은 처음부터 보이게 둔다 — 검색엔진 렌더러는 스크롤하지 않으므로 opacity 0 으로 시작하면
         본문이 빈 화면으로 찍힌다(홈 본문 83% 가 투명했음). 첫 입력(스크롤·터치·키) 뒤에 화면 아래쪽 요소에만 적용하고,
         GSAP 은 이 클래스가 있는 페이지에서만 페이지 로드 후 한가할 때 받는다. -->
    <script>
      type Vars = Record<string, number>;

      const SELECTOR = '.gs-fade-up, .gs-fade-in, .gs-slide-left, .gs-slide-right, .gs-scale-in, .gs-stagger';
      const slideOffset = window.innerWidth < 768 ? 40 : 80;
      // [선택자, 시작 상태, 끝 상태, 길이(초), 이징]
      const PRESETS: [string, Vars, Vars, number, string][] = [
        ['.gs-fade-up', { opacity: 0, y: 60 }, { opacity: 1, y: 0 }, 1, 'power3.out'],
        ['.gs-fade-in', { opacity: 0 }, { opacity: 1 }, 1.2, 'power2.out'],
        ['.gs-slide-left', { opacity: 0, x: -slideOffset }, { opacity: 1, x: 0 }, 1, 'power3.out'],
        ['.gs-slide-right', { opacity: 0, x: slideOffset }, { opacity: 1, x: 0 }, 1, 'power3.out'],
        ['.gs-scale-in', { opacity: 0, scale: 0.9 }, { opacity: 1, scale: 1 }, 1.2, 'power2.out'],
      ];

      let gsapReady: Promise<typeof import('gsap').gsap> | null = null;
      function loadGsap() {
        gsapReady ??= Promise.all([import('gsap'), import('gsap/ScrollTrigger')]).then(([{ gsap }, { ScrollTrigger }]) => {
          gsap.registerPlugin(ScrollTrigger);
          return gsap;
        });
        return gsapReady;
      }

      let armed = false;
      async function arm() {
        if (armed) return;
        armed = true;
        if (!document.querySelector(SELECTOR) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        const gsap = await loadGsap();
        // GSAP 을 받는 사이 이미 화면에 들어온 요소는 건드리지 않는다 (보이던 내용이 깜빡이지 않도록)
        const belowFold = (el: Element) => el.getBoundingClientRect().top > window.innerHeight;
        const scrollTrigger = (trigger: Element) => ({ trigger, start: 'top 85%', once: true });

        for (const [selector, from, to, duration, ease] of PRESETS) {
          gsap.utils.toArray<HTMLElement>(selector).filter(belowFold).forEach((el) => {
            gsap.fromTo(el, from, { ...to, duration, ease, scrollTrigger: scrollTrigger(el) });
          });
        }
        gsap.utils.toArray<HTMLElement>('.gs-stagger').filter(belowFold).forEach((container) => {
          gsap.fromTo(
            container.children,
            { opacity: 0, y: 40 },
            { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', stagger: 0.1, scrollTrigger: scrollTrigger(container) }
          );
        });
      }

      for (const type of ['scroll', 'wheel', 'touchstart', 'keydown', 'pointerdown']) {
        window.addEventListener(type, arm, { once: true, passive: true });
      }
      window.addEventListener('load', () => {
        if (!document.querySelector(SELECTOR)) return;
        const idle = window.requestIdleCallback ?? ((cb: () => void) => setTimeout(cb, 200));
        idle(() => loadGsap());
      });
    </script>
  </body>
</html>
